{
  "name": "apex-admin-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:public": "vite --mode public",
    "dev:admin": "vite --mode admin",
    "dev:chat": "node --env-file-if-exists=.env.chat-server.local --experimental-strip-types server/chat/server.ts",
    "build": "npm run build:public",
    "build:public": "tsc -b && vite build --mode public",
    "build:admin": "tsc -b && vite build --mode admin",
    "lint": "oxlint",
    "preview": "vite preview --mode public",
    "preview:public": "vite preview --mode public",
    "preview:admin": "vite preview --mode admin"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
