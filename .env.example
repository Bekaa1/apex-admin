VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Separate Chat project: public browser credentials only.
VITE_CHAT_SUPABASE_URL=
VITE_CHAT_SUPABASE_PUBLISHABLE_KEY=

# Server process only (.env.chat-server.local / server runtime.env).
# Apex PUBLIC key + authenticated caller JWT preserve RLS for statistics reports.
APEX_PUBLIC_SUPABASE_URL=
APEX_PUBLIC_SUPABASE_KEY=
OPENROUTER_API_KEY=
STATS_REPORT_MODEL=
