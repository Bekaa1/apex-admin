{
  "name": "apex-design-kit-react",
  "private": true,
  "version": "1.0.0",
  "description": "Apex design system, auth screens and landing (React 18 + TypeScript). Reference sources: copy src/ into the app; this manifest only lists what the code needs.",
  "scripts": {
    "typecheck": "tsc -p .",
    "build:reference": "esbuild src/demo/main.tsx --bundle --format=iife --minify --target=es2019 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=../reference/js/app.js"
  },
  "dependencies": {
    "@fontsource/geologica": "^5.0.0",
    "@fontsource/onest": "^5.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
